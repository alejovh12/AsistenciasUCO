SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=gestionasistenciadb;encrypt=false
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Runtime security (validacion de JWT) - ver docs/security/runtime-security-provider-architecture.md
KEYCLOAK_ISSUER_URI=http://127.0.0.1:8081/realms/asistencias-uco
KEYCLOAK_API_CLIENT_ID=asistencias-api
KEYCLOAK_EXPECTED_AUDIENCE=asistencias-api
KEYCLOAK_USER_ID_CLAIM=idUsuario

# Identity provisioning administrativo - ver docs/security/keycloak-identity-provider.md
# Requiere un client confidencial con Service Accounts habilitado (ver
# docs/security/keycloak-service-account.md). NO existe password grant ni admin user/password.
KEYCLOAK_SERVER_URL=http://127.0.0.1:8081
KEYCLOAK_REALM=asistencias-uco
KEYCLOAK_ADMIN_CLIENT_ID=asistencias-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_USER_ID_ATTRIBUTE=idUsuario

APP_ADAPTERS_IDENTITY_PROVIDER=keycloak
APP_ADAPTERS_SECURITY_PROVIDER=keycloak
APP_ADAPTERS_STORAGE_PROVIDER=minio
APP_ADAPTERS_REALTIME_PROVIDER=local-sse
APP_ADAPTERS_AUDIT_PROVIDER=logging

# LB-004B.2H: identidad tecnica de aplicacion para MinIO local (infra/files/compose.yaml).
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD pertenecen exclusivamente a infra/files/.env y NUNCA se
# agregan al entorno de Spring Boot.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=asistencias-soportes

# LB-004B.2H: ClamAV DEV_ONLY publicado exclusivamente en loopback.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:4200

MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

ASISTENCIAS_UCO_LOG_FILE=infra/observability/logs/asistencias-uco.jsonl
ASISTENCIAS_UCO_LOG_FILE_PATTERN=infra/observability/logs/asistencias-uco.%d{yyyy-MM-dd}.%i.jsonl
ASISTENCIAS_UCO_LOG_MAX_FILE_SIZE=10MB
ASISTENCIAS_UCO_LOG_MAX_HISTORY=7
ASISTENCIAS_UCO_LOG_TOTAL_SIZE_CAP=1GB
ASISTENCIAS_UCO_ENVIRONMENT=local
