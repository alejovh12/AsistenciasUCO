SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=gestionasistenciadb;encrypt=false
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.microsoft.sqlserver.jdbc.SQLServerDriver
# Espera maxima por una conexion del pool (ms) y login del driver (s); con SQL Server caido la API responde 503 en ese plazo.
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=5000
SPRING_DATASOURCE_LOGIN_TIMEOUT_SECONDS=5

# Runtime security (validacion de JWT) - ver docs/security/runtime-security-provider-architecture.md
KEYCLOAK_ISSUER_URI=http://127.0.0.1:8081/realms/asistencias-uco
KEYCLOAK_API_CLIENT_ID=asistencias-api
KEYCLOAK_EXPECTED_AUDIENCE=asistencias-api
KEYCLOAK_USER_ID_CLAIM=idUsuario

# Identity provisioning administrativo - ver docs/security/keycloak-identity-provider.md
# Requiere un client confidencial con Service Accounts habilitado (ver
# docs/security/keycloak-service-account.md). NO existe password grant ni admin user/password.
KEYCLOAK_SERVER_URL=http://127.0.0.1:8081
KEYCLOAK_REALM=asistencias-uco
KEYCLOAK_ADMIN_CLIENT_ID=asistencias-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_USER_ID_ATTRIBUTE=idUsuario

APP_ADAPTERS_IDENTITY_PROVIDER=keycloak
APP_ADAPTERS_SECURITY_PROVIDER=keycloak
APP_ADAPTERS_STORAGE_PROVIDER=minio
APP_ADAPTERS_REALTIME_PROVIDER=local-sse
APP_ADAPTERS_AUDIT_PROVIDER=logging

# LB-004B.2H: identidad tecnica de aplicacion para MinIO local (infra/files/compose.yaml).
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD pertenecen exclusivamente a infra/files/.env y NUNCA se
# agregan al entorno de Spring Boot.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=asistencias-soportes

# LB-004B.2H: ClamAV DEV_ONLY publicado exclusivamente en loopback.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:4200

# OBS-09: 1.0 en desarrollo; 0.25 en staging y 0.1 en produccion (docs/observability/README.md).
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

ASISTENCIAS_UCO_LOG_FILE=infra/observability/logs/asistencias-uco.jsonl
ASISTENCIAS_UCO_LOG_FILE_PATTERN=infra/observability/logs/asistencias-uco.%d{yyyy-MM-dd}.%i.jsonl
ASISTENCIAS_UCO_LOG_MAX_FILE_SIZE=10MB
ASISTENCIAS_UCO_LOG_MAX_HISTORY=7
ASISTENCIAS_UCO_LOG_TOTAL_SIZE_CAP=1GB
ASISTENCIAS_UCO_ENVIRONMENT=local

# Proveedor "Catalogo de Parametros" (solo con APP_ADAPTERS_PARAMETER_CATALOG_PROVIDER=catalogoparametros)
# URL base de la API del componente externo
CATALOGO_PARAMETROS_BASE_URL=http://localhost:8081/catalogo-parametros/api/v1
# INT-004: lectura M2M (client_credentials contra Security Baseline); el Catalogo resuelve aplicacion y ambiente desde el client_id
CATALOGO_PARAMETROS_M2M_TOKEN_URI=http://localhost:19090/realms/security-baseline/protocol/openid-connect/token
CATALOGO_PARAMETROS_M2M_CLIENT_ID=
# Secreto de la identidad de servicio (no commitear valores reales; en el baul: asistencias-catalogo-parametros-client-secret)
CATALOGO_PARAMETROS_M2M_CLIENT_SECRET=
# Opcionales: si se definen, los eventos de otra aplicacion o ambiente se ignoran
CATALOGO_PARAMETROS_APPLICATION_ID=
CATALOGO_PARAMETROS_ENVIRONMENT_ID=
# Timeout HTTP, vigencia de cache (0 la desactiva) y separador grupo/clave
CATALOGO_PARAMETROS_TIMEOUT=10s
CATALOGO_PARAMETROS_CACHE_TTL=5m
CATALOGO_PARAMETROS_SEPARADOR=.
# INT-004: eventos Pulsar del Catalogo (broker propio del Catalogo: pulsar://localhost:6652 desde el PC, pulsar://pulsar-parametros:6650 en su red)
CATALOGO_PARAMETROS_EVENTS_ENABLED=true
CATALOGO_PARAMETROS_PULSAR_URL=pulsar://localhost:6652
# Vacio = persistent://public/default/catalogo-parametros-events-<CLIENT_ID>
CATALOGO_PARAMETROS_EVENTS_TOPIC=
CATALOGO_PARAMETROS_EVENTS_SUBSCRIPTION=asistencias-uco-backend-parametros
# Una lectura M2M al arrancar copia los valores vigentes en la BD (no es sondeo)
CATALOGO_PARAMETROS_RECONCILE_ON_STARTUP=true

# Proveedor "MessageUcoLab" 0.3.0 (solo con APP_ADAPTERS_MESSAGE_CATALOG_PROVIDER=messageucolab). INT-003.
MESSAGEUCOLAB_URL=http://localhost:8000
# Identidad de servicio (rol MESSAGE_CONSUMER) creada en la consola de Seguridad y asociada al ambiente en MessageUcoLab
MESSAGEUCOLAB_TOKEN_URI=http://localhost:19090/realms/security-baseline/protocol/openid-connect/token
MESSAGEUCOLAB_CLIENT_ID=
# Secreto de la identidad (se ve una sola vez al crearla; no commitear valores reales)
MESSAGEUCOLAB_CLIENT_SECRET=
# Avisos de cambio por Pulsar: el kit publica el puerto 6800 hacia el PC
MESSAGEUCOLAB_EVENTS_ENABLED=true
MESSAGEUCOLAB_PULSAR_URL=pulsar://localhost:6800
