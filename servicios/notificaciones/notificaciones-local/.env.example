# Servicio de Notificaciones UCO - variables de entorno del laboratorio.
# Copie este archivo a .env y reemplace SOLO los valores <...>. No suba .env a ningun repositorio.
# Los valores reales del SMTP del laboratorio ya existen en los .env de Infra/Backend (SMTP_NOTIFICATION_*): copielos de alli.

# --- Seguridad entre servicios (cabecera X-Api-Key). El mismo valor lo usa el backend de Asistencias. ---
NOTIFICACIONES_API_KEY=<clave-larga-aleatoria>

# --- Base de datos propia (se crea con scripts/crear-bd.ps1 en el SQL Server del laboratorio) ---
NOTIFICACIONES_DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=notificacionesdb;encrypt=true;trustServerCertificate=true
NOTIFICACIONES_DB_USER=notificacionesdb
NOTIFICACIONES_DB_PASSWORD=<clave-del-login-notificacionesdb>

# --- Canal: smtp envia de verdad; log solo registra (sin SMTP). ---
NOTIFICACIONES_CANAL=smtp

# --- SMTP (mismos nombres que tenia el backend de Asistencias) ---
SMTP_NOTIFICATION_HOST=<host-smtp>
SMTP_NOTIFICATION_PORT=587
SMTP_NOTIFICATION_USERNAME=<usuario-smtp>
SMTP_NOTIFICATION_PASSWORD=<clave-smtp>
SMTP_NOTIFICATION_STARTTLS=true
SMTP_NOTIFICATION_SSL=false
SMTP_NOTIFICATION_FROM_ADDRESS=<remitente@dominio>
SMTP_NOTIFICATION_FROM_NAME=Asistencia UCO
SMTP_NOTIFICATION_MAX_BCC=50
SMTP_NOTIFICATION_RATE_PER_MINUTE=60
SMTP_NOTIFICATION_RATE_PER_DAY=500
# Enlace "Ir a la plataforma" del pie del correo (vacio = sin enlace).
SMTP_NOTIFICATION_PLATFORM_URL=http://localhost:4200
# Modo de pruebas: true redirige TODO a los buzones de REDIRECT_TO (1 a 5, separados por coma) y marca el asunto.
SMTP_NOTIFICATION_TEST_MODE_ENABLED=true
SMTP_NOTIFICATION_TEST_MODE_REDIRECT_TO=<buzon-de-prueba@dominio>

# --- Despachador de la cola (valores por defecto; descomente para cambiarlos) ---
# DISPATCHER_ENABLED=true
# DISPATCHER_BATCH_SIZE=50
# DISPATCHER_LEASE=60s
# DISPATCHER_SWEEPER_INTERVAL=30s
# DISPATCHER_MAX_ATTEMPTS=5
# DISPATCHER_BACKOFF_BASE=30s
# DISPATCHER_BACKOFF_MAX=15m
# DISPATCHER_RETENTION_DAYS=30

# --- Observabilidad (opcional) ---
# MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=true
# MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://asis-obs-alloy:4318/v1/traces
# NOTIFICACIONES_LOG_FORMAT=logstash

# --- Solo para scripts/crear-bd.ps1 (SA del SQL Server del laboratorio; sale de AsistenciasUCO-Infra/stack/.env) ---
# MSSQL_SA_PASSWORD=<clave-sa>
