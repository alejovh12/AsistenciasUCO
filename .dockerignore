.git
.github

# Cache local de Maven (repositorio local, NO el Maven Wrapper).
# .mvn/, mvnw y mvnw.cmd se conservan deliberadamente: son el wrapper, no cache.
.maven/

**/.env
**/.env.*
!**/.env.example

.idea
.vscode

# El build de CI genera el JAR antes de construir la imagen Docker.
# Excluimos el resto de target/ pero conservamos el artefacto empaquetado
# que el Dockerfile copia dentro de la imagen.
target/*
!target/AsistenciasUCO-0.0.1-SNAPSHOT.jar

.tmp
.tmp-log-metadata

uploads
logs

*.log

bootrun-*.log

README-local*
