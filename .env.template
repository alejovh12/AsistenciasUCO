# Proveedor de notificaciones y despachador outbox (NOTIF-001 / NOTIF-002A)
APP_ADAPTERS_NOTIFICATION_PROVIDER=
OUTBOX_NOTIFICATION_SENDER=
OUTBOX_NOTIFICATION_DISPATCHER_ENABLED=
OUTBOX_NOTIFICATION_BATCH_SIZE=
OUTBOX_NOTIFICATION_LEASE=
OUTBOX_NOTIFICATION_SWEEPER_INTERVAL=
OUTBOX_NOTIFICATION_MAX_ATTEMPTS=
OUTBOX_NOTIFICATION_BACKOFF_BASE=
OUTBOX_NOTIFICATION_BACKOFF_MAX=
OUTBOX_NOTIFICATION_RETENTION_DAYS=
OUTBOX_NOTIFICATION_RETENTION_INTERVAL=
OUTBOX_NOTIFICATION_INSTANCE_ID=

# Canal de correo SMTP para el outbox de notificaciones (NOTIF-002A)
SMTP_NOTIFICATION_HOST=
SMTP_NOTIFICATION_PORT=
SMTP_NOTIFICATION_USERNAME=
SMTP_NOTIFICATION_PASSWORD=
SMTP_NOTIFICATION_STARTTLS=
SMTP_NOTIFICATION_SSL=
SMTP_NOTIFICATION_FROM_ADDRESS=
SMTP_NOTIFICATION_FROM_NAME=
SMTP_NOTIFICATION_CONNECT_TIMEOUT=
SMTP_NOTIFICATION_READ_TIMEOUT=
SMTP_NOTIFICATION_MAX_BCC=
SMTP_NOTIFICATION_RATE_PER_MINUTE=
SMTP_NOTIFICATION_RATE_PER_DAY=
SMTP_NOTIFICATION_REQUIRE_CONFIRMED_EMAIL=
SMTP_NOTIFICATION_PLATFORM_URL=
SMTP_NOTIFICATION_TEMPLATE_CACHE_TTL=

# Modo de pruebas con redireccion de correo (D15 - apagado por defecto en produccion)
SMTP_NOTIFICATION_TEST_MODE_ENABLED=
SMTP_NOTIFICATION_TEST_MODE_REDIRECT_TO=

# IDENT-001: limite de intentos por IP del endpoint publico de verificacion de correo
VERIFICACION_CORREO_LIMITE_POR_MINUTO=20
VERIFICACION_CORREO_MAX_CLAVES=10000

# Proveedor "Catalogo de Parametros" (solo con APP_ADAPTERS_PARAMETER_CATALOG_PROVIDER=catalogoparametros)
# URL base de la API del componente externo
CATALOGO_PARAMETROS_BASE_URL=http://localhost:8081/catalogo-parametros/api/v1
# Identificador (UUID) del token de consumo; define aplicacion y ambiente
CATALOGO_PARAMETROS_TOKEN_ID=
# Secreto Bearer del token (no commitear valores reales)
CATALOGO_PARAMETROS_SECRETO=
# Opcionales: solo trazabilidad
CATALOGO_PARAMETROS_APPLICATION_ID=
CATALOGO_PARAMETROS_ENVIRONMENT_ID=
# Timeout HTTP, vigencia de cache (0 la desactiva) y separador grupo/clave
CATALOGO_PARAMETROS_TIMEOUT=10s
CATALOGO_PARAMETROS_CACHE_TTL=5m
CATALOGO_PARAMETROS_SEPARADOR=.
