# Bootstrap/administration identity. Solo la consumen minio y minio-init.
MINIO_ROOT_USER=CHANGE_ME_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Identidad tecnica de aplicacion. Debe coincidir con MINIO_ACCESS_KEY/MINIO_SECRET_KEY
# configurados para Spring Boot, pero las credenciales root nunca se copian al backend.
MINIO_ACCESS_KEY=CHANGE_ME_APP_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_APP_SECRET_KEY

# Puertos DEV_ONLY publicados exclusivamente en loopback para backend ejecutado desde IntelliJ.
MINIO_HOST_PORT=9000
CLAMAV_HOST_PORT=3310
