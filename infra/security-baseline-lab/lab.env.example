# SEC-BASELINE-001 — plantilla NO funcional del env-file del laboratorio.
# No copiar a mano: ejecutar scripts/new-lab-env.ps1, que genera valores aleatorios en
# %USERPROFILE%\.asistencias-security-lab\lab.env (fuera de Git, ACL solo del usuario actual).
#
# Organización Docker Hub verificada (ver LAB_RUNBOOK.md, sección "Procedencia de imágenes"):
# las etiquetas 0.1.6 fueron publicadas por el workflow oficial del tag v0.1.6.
SECURITY_DOCKER_ORG=davidalzate
SECURITY_VERSION=0.1.6
KEYCLOAK_PORT=19090
PDP_PORT=18080
PEP_PORT=18081
PDP_SECURITY_MFA_ENABLED=false
SECURITY_KC_ADMIN_USERNAME=<generado>
SECURITY_KC_ADMIN_PASSWORD=<generado>
SECURITY_SURREALDB_USERNAME=root
SECURITY_SURREALDB_PASSWORD=<generado>
# Se escriben en Keycloak con scripts/rotate-lab-client-secrets.ps1 (sustituyen los literales del realm upstream).
SECURITY_PDP_KEYCLOAK_CLIENT_SECRET=<generado>
SECURITY_PEP_INTERNAL_CLIENT_SECRET=<generado>
