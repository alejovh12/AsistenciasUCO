# Plantilla NO funcional del env-file de Security Baseline. Valores reales: %USERPROFILE%\.asistencias-security-lab\lab.env
# (fuera de Git, ACL solo del usuario). Nunca copiar secretos reales a este archivo.
SECURITY_DOCKER_ORG=davidalzate
SECURITY_VERSION=0.1.14
KEYCLOAK_PORT=19090
PDP_PORT=18080
PEP_PORT=18081
PDP_SECURITY_MFA_ENABLED=false
SECURITY_KC_ADMIN_USERNAME=<generado>
SECURITY_KC_ADMIN_PASSWORD=<generado>
SECURITY_SURREALDB_USERNAME=root
SECURITY_SURREALDB_PASSWORD=<generado>
SECURITY_PDP_KEYCLOAK_CLIENT_SECRET=<generado>
SECURITY_PEP_INTERNAL_CLIENT_SECRET=<generado>
PDP_KEYCLOAK_PROVISIONER_CLIENT_SECRET=<generado-localmente-0.1.13>
# SEC-BASELINE-020 (0.1.14): RabbitMQ de eventos de asignacion. No usar guest/guest (bloqueado a loopback).
RABBITMQ_IMAGE=rabbitmq:4.4.1-management
RABBITMQ_USERNAME=<generado>
RABBITMQ_PASSWORD=<generado>
RABBITMQ_AMQP_PORT=25672
RABBITMQ_MANAGEMENT_PORT=25673
