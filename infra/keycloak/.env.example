KEYCLOAK_VERSION=26.7.1

KC_HTTP_PORT=8081
KC_MANAGEMENT_PORT=9001

KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

KC_DB_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Contrato del realm (ver README.md para el mapeo completo hacia las variables
# KEYCLOAK_* que lee el backend Spring Boot).
# ---------------------------------------------------------------------------

KC_REALM=asistencias-uco

KC_API_CLIENT_ID=asistencias-api
KC_FRONTEND_CLIENT_ID=asistencias-uco-frontend
KC_BACKEND_ADMIN_CLIENT_ID=asistencias-backend-admin

# Secret del client confidencial asistencias-backend-admin. Obligatorio para
# bootstrap-keycloak.ps1 (falla fail-fast si falta). Debe coincidir con
# KEYCLOAK_ADMIN_CLIENT_SECRET del backend (application.yml / entorno del backend).
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Longitud minima de password. Default institucional = 12. Un desarrollador local puede bajarlo
# (por ejemplo a 8) si explicitamente quiere una politica menos estricta en su ambiente; nunca
# se hardcodea un valor mas debil que 12 en los scripts.
KC_PASSWORD_MIN_LENGTH=12

# Migracion de roles legacy (AD/DE/CD/DO/ES -> ADMINISTRADOR/DECANO/COORDINADOR/DOCENTE/ESTUDIANTE).
# bootstrap-keycloak.ps1 siempre migra los role mappings de usuarios; estos flags solo controlan
# el borrado adicional. Default false: nunca se borra nada automaticamente.
KC_REMOVE_LEGACY_ROLES=false

# Client legacy 'asistencias-frontend' detectado junto al canonico 'asistencias-uco-frontend'.
# Default false: nunca se borra automaticamente.
KC_REMOVE_LEGACY_FRONTEND_CLIENT=false

# ---------------------------------------------------------------------------
# Seed opcional de usuarios E2E (scripts/seed-e2e-users.ps1). Nunca se versionan usuarios
# reales; esto es solo para pruebas manuales locales.
# ---------------------------------------------------------------------------

E2E_DOCENTE_USERNAME=docente.prueba
E2E_DOCENTE_PASSWORD=change-me
# Debe ser un dbo.Usuario.id REAL en SQL Server para poder probar autorizacion contextual.
# Si se deja vacio, seed-e2e-users.ps1 omite este usuario.
E2E_DOCENTE_ID_USUARIO=

E2E_ADMIN_USERNAME=admin.prueba
E2E_ADMIN_PASSWORD=change-me
E2E_ADMIN_ID_USUARIO=

# Si es true, seed-e2e-users.ps1 resetea la password de un usuario E2E que ya existe.
# Default false: nunca se resetea una password existente sin flag explicito.
KC_RESET_EXISTING_E2E_PASSWORDS=false
